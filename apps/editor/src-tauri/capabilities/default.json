{
  "$schema": "https://schema.tauri.app/capability/2",
  "identifier": "default",
  "description": "Spike minimal: fs/dialog + shell allow-execute for grub tools",
  "windows": ["main"],
  "permissions": [
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "grub-mkfont-spike",
          "cmd": "grub-mkfont",
          "args": ["--version", true]
        },
        {
          "name": "grub2-theme-preview-spike",
          "cmd": "grub2-theme-preview",
          "args": ["--help", true]
        }
      ]
    },
    "shell:allow-open"
  ]
}
