{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GrubThemeEditor",
  "version": "0.0.0-spike",
  "identifier": "com.grubtheme.editor.spike",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --filter editor dev",
    "beforeBuildCommand": "pnpm --filter editor build"
  },
  "app": {
    "windows": [{ "title": "GrubThemeEditor Spike", "width": 1280, "height": 800 }],
    "security": { "capabilities": ["default"] }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
